{
  "version": 2,
  "builds": [
    { "src": "/api/index.php", "use": "vercel-php@0.7.3" },
    { "src": "/public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(css|js|build|images)/(.*)", "dest": "public/$1/$2" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "isi-dengan-key-dari-php-artisan-key:generate --show",
    "APP_CONFIG_CACHE": "/tmp/config.cache",
    "APP_EVENTS_CACHE": "/tmp/events.cache",
    "APP_PACKAGES_CACHE": "/tmp/packages.cache",
    "APP_ROUTES_CACHE": "/tmp/routes.cache",
    "APP_SERVICES_CACHE": "/tmp/services.cache",
    "VIEW_COMPILED_PATH": "/tmp",
    "CACHE_DRIVER": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr"
  }
}